# These two use `localhost` because that's what the host-side scripts under /scripts
# (seed.ts, create-tenant.ts, verify-audit-immutability.ts) and `bun run db:migrate` need
# when run directly on your machine against the port docker-compose publishes below.
# The containerized web/worker/migrate services do NOT use these values - docker-compose.yml
# overrides both to use `postgres` (the service name) instead of `localhost`, since
# `localhost` inside a container means the container itself, not the postgres container.

# Postgres, connected as the migration-owner role (DDL rights, bypasses RLS).
# Only used by `bun run db:migrate` / `db:generate` / seed scripts, never by the running app.
DATABASE_MIGRATION_URL=postgres://galm_migrator:migrator_dev_password@localhost:5432/galm

# Postgres, connected as the least-privilege app_runtime role (RLS-bound, no DDL rights).
# This is the only DB credential apps/web and apps/worker ever use.
DATABASE_URL=postgres://app_runtime:app_runtime_dev_password@localhost:5432/galm

# better-auth
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Local-filesystem storage driver
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/evidence
STORAGE_SIGNING_SECRET=dev-only-change-me-storage-signing-secret

# pg-boss reuses DATABASE_URL for its own schema (`pgboss`), no separate service needed.

# DEV/CI ONLY - never set this in a real deployment. Gates a test-only fake AI-model
# branch inside packages/integrations/llm's resolveModel, which only fires for a
# connection whose base URL is the exact sentinel `mock://step-suggestions` (a real
# connection can never legitimately have that) - lets the e2e suite exercise AI-assisted
# test step drafting (backlog item 9.37) end to end without ever calling a real, paid
# LLM API. Leave unset in production; a real tenant's own saved connection is unaffected
# either way since this only matches that one sentinel URL.
# ALLOW_MOCK_LLM_PROVIDER=1
